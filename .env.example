# Claude model/effort overrides. All optional; unset uses the defaults shown.
# Effort must be low, medium, or high (anything else falls back to the default).

# Recommendation endpoint (lib/recommend/recommend.ts)
RECOMMEND_MODEL=claude-opus-4-8
RECOMMEND_EFFORT=high

# Taste profile synthesis (lib/taste-profile/synthesize.ts)
PROFILE_MODEL=claude-opus-4-8
PROFILE_EFFORT=high
